# RIK-RIDE Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Configuration
# Application database: rik_ride
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/rik_ride?appName=Cluster0

# Security Secrets (Keep confidential and never commit real values)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
QR_HMAC_SECRET=your-super-secret-qr-hmac-key-min-32-chars

# Client Environment Variables
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_WS_URL=ws://localhost:5000
